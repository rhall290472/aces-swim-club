{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Home",
      "type": "chrome",
      "request": "launch",
      "file": "${workspaceFolder}/home.html",
      "webRoot": "${workspaceFolder}"
    },
    {
      "name": "Join / Tryouts",
      "type": "chrome",
      "request": "launch",
      "file": "${workspaceFolder}/ACES-join-tryouts.html",
